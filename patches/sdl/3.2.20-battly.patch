+void Android_MakeWindowCurrent(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_WindowData *data;
+    SDL_WindowData *old_data;
+    ANativeWindow *native_window;
+
+    if (!window || window == Android_Window || !window->internal || !Android_Window || !Android_Window->internal) {
+        return;
+    }
+
+    data = window->internal;
+    old_data = Android_Window->internal;
+    native_window = Android_JNI_GetNativeWindow();
+    if (!native_window) {
+        SDL_Log("Failed to fetch ANativeWindow while switching SDL windows");
+        return;
+    }
+
+    data->native_window = native_window;
+    old_data->native_window = NULL;
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+    _this->egl_data->eglMakeCurrent(_this->egl_data->egl_display,
+                                    EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (old_data->egl_surface != EGL_NO_SURFACE) {
+        SDL_EGL_DestroySurface(_this, old_data->egl_surface);
+    }
+    if (data->egl_surface != EGL_NO_SURFACE) {
+        SDL_EGL_DestroySurface(_this, data->egl_surface);
+    }
+
+    if (Android_Window->flags & SDL_WINDOW_OPENGL) {
+        old_data->egl_surface = SDL_EGL_CreateOffscreenSurface(_this,
+                                                               Android_SurfaceWidth,
+                                                               Android_SurfaceHeight);
+        old_data->surface_changed = true;
+    }
+    if (window->flags & SDL_WINDOW_OPENGL) {
+        data->egl_surface = SDL_EGL_CreateSurface(_this, window, (NativeWindowType)data->native_window);
+        if (data->egl_surface == EGL_NO_SURFACE) {
+            SDL_Log("Failed to create EGLSurface on the active SDL window");
+        }
+        data->surface_changed = true;
+    }
+#endif
+
+    Android_Window = window;
+}
+
+static void Android_DestroyOffscreenWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    if (!window->internal) {
+        return;
+    }
+
+    SDL_WindowData *data = window->internal;
+#ifdef SDL_VIDEO_OPENGL_EGL
+    if (data->egl_surface != EGL_NO_SURFACE) {
+        SDL_EGL_DestroySurface(_this, data->egl_surface);
+    }
+#endif
+    SDL_free(window->internal);
+    window->internal = NULL;
+}
