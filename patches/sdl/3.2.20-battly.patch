+static Uint64 battly_fps_window_start_ns;
+static int battly_fps_window_frames;
+static int battly_renderer_fps;
+
+int Android_GLES_GetRendererFPS(void)
+{
+    return battly_renderer_fps;
+}
+
+static void Android_GLES_RecordFrame(void)
+{
+    const Uint64 now = SDL_GetTicksNS();
+    if (battly_fps_window_start_ns == 0) {
+        battly_fps_window_start_ns = now;
+    }
+    battly_fps_window_frames++;
+    const Uint64 elapsed = now - battly_fps_window_start_ns;
+    if (elapsed >= SDL_NS_PER_SECOND) {
+        battly_renderer_fps = (int)(((Uint64)battly_fps_window_frames * SDL_NS_PER_SECOND) / elapsed);
+        battly_fps_window_frames = 0;
+        battly_fps_window_start_ns = now;
+    }
+}
