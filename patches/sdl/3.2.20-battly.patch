     if (window && context) {
         return SDL_EGL_MakeCurrent(_this, window->internal->egl_surface, context);
     } else {
@@ -73,7 +100,16 @@ bool Android_GLES_SwapWindow(SDL_VideoDevice *_this, SDL_Window *window)
 
     /*_this->egl_data->eglWaitNative(EGL_CORE_NATIVE_ENGINE);
     _this->egl_data->eglWaitGL();*/
+    if (window->internal->surface_changed) {
+        SDL_GLContext current_context = SDL_GL_GetCurrentContext();
+        SDL_EGL_MakeCurrent(_this, window->internal->egl_surface, (EGLContext)current_context);
+        window->internal->surface_changed = false;
+    }
+
     result = SDL_EGL_SwapBuffers(_this, window->internal->egl_surface);
+    if (result) {
+        Android_GLES_RecordFrame();
+    }
 
     Android_UnlockActivityMutex();
 
