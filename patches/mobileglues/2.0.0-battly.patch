+
+        for (size_t i = 0; i + 1 < backend_attributes->size(); i += 2) {
+            const EGLint attribute = (*backend_attributes)[i];
+            if (attribute == EGL_NONE) break;
+            const EGLint value = (*backend_attributes)[i + 1];
