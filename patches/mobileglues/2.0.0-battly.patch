+                                                           : global_settings.custom_gl_version.Major;
+    }
+
+    EGLint defaultDesktopMinorVersion() {
+        return global_settings.custom_gl_version.isEmpty() ? DEFAULT_GL_VERSION % 10
+                                                           : global_settings.custom_gl_version.Minor;
