<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/fragment_padding_medium"
    android:paddingTop="@dimen/fragment_padding_medium"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_battly_form_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_battly_form_field"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_battly_logs_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:text="@string/log_viewer_title"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/log_viewer_subtitle"
                android:textColor="#BFD2DC"
                android:textSize="11sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/log_viewer_selector"
            android:layout_width="210dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_battly_form_field"
            android:paddingHorizontal="8dp"
            android:popupBackground="@drawable/bg_battly_popup"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_form_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/log_viewer_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/log_viewer_search"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#8295A5"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/log_viewer_live"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingHorizontal="14dp"
            android:text="@string/log_viewer_live_off"
            android:textColor="#D9E5EB"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/log_viewer_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:contentDescription="@string/log_viewer_refresh"
            android:padding="12dp"
            android:src="@drawable/ic_refresh"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/log_viewer_copy"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:contentDescription="@string/log_viewer_copy"
            android:padding="11dp"
            android:src="@drawable/ic_battly_copy_line" />

        <TextView
            android:id="@+id/log_viewer_share"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:gravity="center"
            android:minWidth="78dp"
            android:paddingHorizontal="14dp"
            android:text="@string/log_viewer_share"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_viewer_upload"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_battly_button_primary"
            android:gravity="center"
            android:minWidth="100dp"
            android:paddingHorizontal="14dp"
            android:text="@string/log_viewer_upload"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/log_viewer_stat_lines"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_battly_form_field"
            android:gravity="center"
            android:minWidth="98dp"
            android:paddingHorizontal="12dp"
            android:textColor="#D8E4EA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_viewer_stat_warnings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_battly_form_field"
            android:gravity="center"
            android:minWidth="98dp"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFC857"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_viewer_stat_errors"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_battly_form_field"
            android:gravity="center"
            android:minWidth="98dp"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFF8E9A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/log_filter_all"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_battly_button_primary"
            android:gravity="center"
            android:minWidth="66dp"
            android:paddingHorizontal="12dp"
            android:text="@string/log_viewer_filter_all"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_filter_errors"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="12dp"
            android:text="@string/log_viewer_filter_errors"
            android:textColor="#D9E5EB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_filter_warnings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:gravity="center"
            android:minWidth="78dp"
            android:paddingHorizontal="12dp"
            android:text="@string/log_viewer_filter_warnings"
            android:textColor="#D9E5EB"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="1"
        android:background="@drawable/bg_battly_form_panel"
        android:orientation="vertical"
        android:padding="13dp">

        <TextView
            android:id="@+id/log_viewer_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#829AA8"
            android:textSize="10sp" />

        <com.kdt.DefocusableScrollView
            android:id="@+id/log_viewer_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="9dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_form_field"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/log_viewer_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:text="@string/log_viewer_loading"
                android:textColor="#FFDCE6EB"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </com.kdt.DefocusableScrollView>
    </LinearLayout>
</LinearLayout>
