<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/fragment_padding_medium"
    android:paddingTop="@dimen/fragment_padding_medium"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_battly_form_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_viewer_title"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="600dp"
                android:text="@string/log_viewer_subtitle"
                android:textColor="#C7D4DF"
                android:textSize="12sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/log_viewer_selector"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_battly_form_field"
            android:padding="4dp"
            android:popupBackground="@drawable/bg_battly_popup"
            android:spinnerMode="dropdown" />

        <TextView
            android:id="@+id/log_viewer_refresh"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:gravity="center"
            android:minWidth="80dp"
            android:paddingHorizontal="14dp"
            android:text="@string/log_viewer_refresh"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_viewer_copy"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:gravity="center"
            android:minWidth="80dp"
            android:paddingHorizontal="14dp"
            android:text="@string/log_viewer_copy"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_viewer_share"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_battly_button_primary"
            android:gravity="center"
            android:minWidth="90dp"
            android:paddingHorizontal="14dp"
            android:text="@string/log_viewer_share"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_battly_form_panel"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/log_viewer_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94C7D4DF"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/log_viewer_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_battly_form_field"
                    android:fontFamily="monospace"
                    android:minWidth="960dp"
                    android:padding="16dp"
                    android:text="@string/log_viewer_loading"
                    android:textColor="#FFF4F6F8"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </ScrollView>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
