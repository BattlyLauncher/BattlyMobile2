<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_battly_form_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_battly_form_field"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_battly_logs_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:text="@string/log_viewer_title"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/log_viewer_subtitle"
                android:textColor="#BFD2DC"
                android:textSize="9sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/log_viewer_selector"
            android:layout_width="230dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_battly_form_field"
            android:paddingHorizontal="8dp"
            android:popupBackground="@drawable/bg_battly_popup"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_form_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/log_viewer_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/log_viewer_search"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#8295A5"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/log_viewer_live"
            android:layout_width="78dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:text="@string/log_viewer_live_off"
            android:textColor="#D9E5EB"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/log_viewer_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:contentDescription="@string/log_viewer_refresh"
            android:padding="11dp"
            android:src="@drawable/ic_refresh"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/log_viewer_copy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:contentDescription="@string/log_viewer_copy"
            android:padding="10dp"
            android:src="@drawable/ic_battly_copy_line" />

        <TextView
            android:id="@+id/log_viewer_share"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:gravity="center"
            android:text="@string/log_viewer_share"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_viewer_upload"
            android:layout_width="82dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_battly_button_primary"
            android:gravity="center"
            android:text="@string/log_viewer_upload"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:id="@+id/log_viewer_stat_lines" style="@style/BattlyLogCompactChip" android:textColor="#D8E4EA" />
        <TextView android:id="@+id/log_viewer_stat_warnings" style="@style/BattlyLogCompactChip" android:layout_marginStart="5dp" android:textColor="#FFFFC857" />
        <TextView android:id="@+id/log_viewer_stat_errors" style="@style/BattlyLogCompactChip" android:layout_marginStart="5dp" android:textColor="#FFFF8E9A" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView android:id="@+id/log_filter_all" style="@style/BattlyLogCompactFilter" android:background="@drawable/bg_battly_button_primary" android:text="@string/log_viewer_filter_all" />
        <TextView android:id="@+id/log_filter_errors" style="@style/BattlyLogCompactFilter" android:layout_marginStart="5dp" android:text="@string/log_viewer_filter_errors" />
        <TextView android:id="@+id/log_filter_warnings" style="@style/BattlyLogCompactFilter" android:layout_marginStart="5dp" android:text="@string/log_viewer_filter_warnings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_battly_form_panel"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/log_viewer_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="#829AA8"
            android:textSize="9sp" />

        <com.kdt.DefocusableScrollView
            android:id="@+id/log_viewer_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_form_field"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/log_viewer_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1dp"
                android:padding="10dp"
                android:text="@string/log_viewer_loading"
                android:textColor="#FFDCE6EB"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </com.kdt.DefocusableScrollView>
    </LinearLayout>
</LinearLayout>
