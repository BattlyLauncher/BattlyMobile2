<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background matching LauncherActivity -->
    <ImageView
        android:id="@+id/onboarding_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_battly_launcher_scrim" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- ViewPager for slides -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboarding_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/onboarding_bottom_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/onboarding_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6121E2C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/onboarding_btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="@string/onboarding_action_skip"
            android:textColor="#A9C7D4DF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/onboarding_btn_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="@string/onboarding_action_back"
            android:textColor="#C7D4DF"
            android:textSize="14sp"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Simple Progress Dots -->
        <LinearLayout
            android:id="@+id/onboarding_dots_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/onboarding_btn_next"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_battly_button_primary"
            android:paddingHorizontal="24dp"
            android:text="@string/onboarding_action_start"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/onboarding_welcome_transition"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20A111A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/onboarding_transition_card"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_game_starting_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="36dp"
            android:paddingVertical="30dp">

            <ImageView
                android:id="@+id/onboarding_transition_logo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/onboarding_transition_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/onboarding_transition_title"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onboarding_transition_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/onboarding_transition_desc"
                android:textColor="#C7D4DF"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/onboarding_transition_progress"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="22dp"
                android:indeterminate="true"
                android:indeterminateTint="#8BE7D4" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
