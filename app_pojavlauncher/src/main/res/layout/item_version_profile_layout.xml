<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_battly_form_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="8dp"
    android:elevation="3dp"
    android:clickable="false">

    <fr.spse.extended_view.ExtendedTextView
        android:id="@+id/profile_item_label"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawablePadding="11dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="32dp" />

    <ImageButton
        android:id="@+id/profile_item_delete"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_battly_launcher_chip"
        android:contentDescription="@string/global_delete"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_delete_compact"
        app:tint="#FFFF9A9A" />
</LinearLayout>
