<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8000000"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_battly_form_panel"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_battly_form_field"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_battly_logs_line" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="@string/log_live_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_live_subtitle"
                    android:textColor="#AFC5D0"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/log_live_counter"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_battly_form_field"
                android:gravity="center"
                android:minWidth="86dp"
                android:paddingHorizontal="12dp"
                android:textColor="#8AF1DE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/log_view_cancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/bg_battly_button_secondary"
                android:contentDescription="@android:string/cancel"
                android:padding="10dp"
                android:src="@drawable/ic_close_white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="11dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_battly_form_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/log_live_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/log_live_search"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#8295A5"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/log_live_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_battly_button_primary"
                android:gravity="center"
                android:minWidth="60dp"
                android:paddingHorizontal="11dp"
                android:text="@string/log_viewer_filter_all"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/log_live_filter_errors"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_battly_button_secondary"
                android:gravity="center"
                android:minWidth="70dp"
                android:paddingHorizontal="11dp"
                android:text="@string/log_viewer_filter_errors"
                android:textColor="#D9E5EB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/log_live_filter_warnings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_battly_button_secondary"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingHorizontal="11dp"
                android:text="@string/log_viewer_filter_warnings"
                android:textColor="#D9E5EB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.kdt.DefocusableScrollView
            android:id="@+id/content_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_form_field"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/content_log_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="13dp"
                android:textColor="#FFDCE6EB"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </com.kdt.DefocusableScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/log_live_clear"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_battly_button_secondary"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingHorizontal="13dp"
                android:text="@string/log_live_clear"
                android:textColor="#D9E5EB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/log_live_copy"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_battly_button_secondary"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingHorizontal="13dp"
                android:text="@string/log_live_copy"
                android:textColor="#D9E5EB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/content_log_toggle_autoscroll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_battly_button_primary"
                android:gravity="center"
                android:minWidth="82dp"
                android:paddingHorizontal="13dp"
                android:text="@string/log_live_follow"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/content_log_toggle_log"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_battly_button_primary"
                android:gravity="center"
                android:minWidth="82dp"
                android:paddingHorizontal="13dp"
                android:text="@string/log_live_pause"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
