<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="32dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Version selector card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_battly_form_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:text="@string/vanilla_install_version_label"
                android:textColor="#C7D4DF"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.06" />

            <LinearLayout
                android:id="@+id/vanilla_version_selector"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_battly_version_option"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/vanilla_selected_version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/vanilla_install_tap_to_select"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_battly_chevron"
                    android:tint="#80FFFFFF"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Profile name card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_battly_form_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:text="@string/vanilla_install_profile_name_label"
                android:textColor="#C7D4DF"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.06" />

            <EditText
                android:id="@+id/vanilla_profile_name"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_battly_version_option"
                android:hint="@string/vanilla_install_profile_name_hint"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Create button -->
        <Button
            android:id="@+id/vanilla_create_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_battly_button_primary"
            android:fontFamily="@font/noto_sans_bold"
            android:text="@string/vanilla_install_create"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

    </LinearLayout>
</com.kdt.DefocusableScrollView>
