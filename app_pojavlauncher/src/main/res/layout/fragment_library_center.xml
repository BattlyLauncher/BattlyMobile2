<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="32dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_battly_launcher_play"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_battly_profile_icon"
                android:padding="8dp"
                android:src="@drawable/minecraft_bookshelf" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/library_workspace_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/library_workspace_subtitle"
                    android:textColor="#E0FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:useDefaultMargins="true">

            <LinearLayout
                android:id="@+id/download_panel_import_modpack"
                style="@style/Widget_Battly_LibraryCard">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/minecraft_name_tag" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardTitle"
                    android:text="@string/download_action_modpack_title" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardSubtitle"
                    android:text="@string/download_action_modpack_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/download_panel_browse_modpacks"
                style="@style/Widget_Battly_LibraryCard">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/minecraft_chest" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardTitle"
                    android:text="@string/download_action_browse_modpacks_title" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardSubtitle"
                    android:text="@string/download_action_browse_modpacks_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/download_panel_browse_mods"
                style="@style/Widget_Battly_LibraryCard">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/minecraft_diamond_pickaxe" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardTitle"
                    android:text="@string/download_action_browse_mods_title" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardSubtitle"
                    android:text="@string/download_action_browse_mods_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/download_panel_browse_resourcepacks"
                style="@style/Widget_Battly_LibraryCard">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/minecraft_bookshelf" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardTitle"
                    android:text="@string/download_action_browse_resourcepacks_title" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardSubtitle"
                    android:text="@string/download_action_browse_resourcepacks_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/download_panel_browse_shaders"
                style="@style/Widget_Battly_LibraryCard">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/minecraft_sunflower" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardTitle"
                    android:text="@string/download_action_browse_shaders_title" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardSubtitle"
                    android:text="@string/download_action_browse_shaders_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/download_panel_browse_datapacks"
                style="@style/Widget_Battly_LibraryCard">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/minecraft_filled_map" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardTitle"
                    android:text="@string/download_action_browse_datapacks_title" />

                <TextView
                    style="@style/Widget_Battly_LibraryCardSubtitle"
                    android:text="@string/download_action_browse_datapacks_subtitle" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/library_installed_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/library_installed_subtitle"
            android:textColor="#C7D4DF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/library_installed_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
