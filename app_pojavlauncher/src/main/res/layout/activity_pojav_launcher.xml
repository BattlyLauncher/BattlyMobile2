<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10161F">

    <FrameLayout
        android:id="@+id/launcher_shell"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_battly_launcher_shell"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/launcher_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/background" />

        <VideoView
            android:id="@+id/launcher_background_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/launcher_background_next"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:id="@+id/launcher_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_battly_launcher_scrim" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/launcher_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/launcher_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/launcher_panel_navigation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/launcher_back_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/launcher_nav_back"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_arrow_back_white"
                        android:tint="#FFFFFFFF"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/launcher_panel_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/noto_sans_bold"
                        android:maxLines="1"
                        android:textColor="#F7F8FB"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="@+id/launcher_back_button"
                        app:layout_constraintEnd_toStartOf="@+id/launcher_home_button"
                        app:layout_constraintStart_toEndOf="@+id/launcher_back_button"
                        app:layout_constraintTop_toTopOf="@+id/launcher_back_button"
                        tools:text="Panel" />

                    <ImageButton
                        android:id="@+id/launcher_home_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/launcher_nav_home"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_menu_home"
                        android:tint="#FFFFFFFF"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/brand_block"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="@+id/top_actions"
                    app:layout_constraintEnd_toStartOf="@+id/top_actions"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/top_actions">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:contentDescription="@null"
                        android:src="@drawable/logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/noto_sans_bold"
                        android:text="@string/app_name"
                        android:textColor="#F7F8FB"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/launcher_build_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/noto_sans_bold"
                        android:text="@string/launcher_mobile_badge"
                        android:textAllCaps="true"
                        android:textColor="#8b9aa7d5"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/top_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/library_button"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_battly_launcher_chip"
                        android:contentDescription="@string/library_button_desc"
                        android:elevation="6dp"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/minecraft_bookshelf" />

                    <ImageButton
                        android:id="@+id/news_button"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_battly_launcher_chip"
                        android:contentDescription="@string/control_hub_title"
                        android:elevation="6dp"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_battly_gamepad_line" />

                    <com.kdt.mcgui.mcAccountSpinner
                        android:id="@+id/account_spinner"
                        android:layout_width="192dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_battly_launcher_account"
                        android:dropDownVerticalOffset="56dp"
                        android:dropDownWidth="232dp"
                        android:dropDownHeight="260dp"
                        android:elevation="6dp"
                        android:popupBackground="@drawable/bg_battly_form_panel"
                        android:spinnerMode="dropdown" />

                    <ImageButton
                        android:id="@+id/setting_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/mcl_options"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_sharp_settings_24"
                        android:tint="#FFFFFFFF" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/container_fragment"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/progress_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/launcher_header" />

            <com.kdt.mcgui.ProgressLayout
                android:id="@+id/progress_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
