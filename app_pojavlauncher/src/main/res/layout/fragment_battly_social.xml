<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_battly_launcher_play"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="15dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_battly_launcher_chip"
            android:padding="9dp"
            android:src="@drawable/ic_battly_social" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:text="@string/battly_social_title"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/battly_social_subtitle"
                android:textColor="#D4E1E8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/social_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#83E3D0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/social_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_battly_launcher_chip"
            android:contentDescription="@string/battly_social_refresh"
            android:padding="11dp"
            android:src="@drawable/ic_refresh"
            android:tint="#FFFFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/social_tab_friends"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_button_primary"
            android:text="@string/battly_social_friends"
            android:textColor="#FF10212B" />

        <Button
            android:id="@+id/social_tab_requests"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_button_secondary"
            android:text="@string/battly_social_requests"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/social_tab_search"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_button_secondary"
            android:text="@string/battly_social_search"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/social_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/social_search_input"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_form_field"
            android:hint="@string/battly_social_search_hint"
            android:imeOptions="actionSearch"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#93A8B7" />

        <ImageButton
            android:id="@+id/social_search_submit"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_battly_button_primary"
            android:contentDescription="@string/battly_social_search"
            android:padding="12dp"
            android:src="@drawable/ic_search"
            android:tint="#FF10212B" />
    </LinearLayout>

    <TextView
        android:id="@+id/social_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/battly_social_loading"
        android:textColor="#C7D4DF"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/social_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="2dp"
        android:paddingBottom="12dp"
        android:scrollbars="none" />
</LinearLayout>
