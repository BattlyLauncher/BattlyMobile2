<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_battly_bottom_sheet"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/dialog_mod_gallery_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_mod_gallery_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_battly_form_field"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="#C7D4DF"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/dialog_mod_gallery_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_battly_form_field"
            android:contentDescription="@string/mod_detail_close"
            android:padding="8dp"
            android:src="@drawable/ic_close_white" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#B0080D13">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/dialog_mod_gallery_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp" />

        <ImageButton
            android:id="@+id/dialog_mod_gallery_previous"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_battly_form_field"
            android:contentDescription="@string/mod_detail_gallery_previous"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_white" />

        <ImageButton
            android:id="@+id/dialog_mod_gallery_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_battly_form_field"
            android:contentDescription="@string/mod_detail_gallery_next"
            android:padding="10dp"
            android:rotation="180"
            android:src="@drawable/ic_arrow_back_white" />
    </FrameLayout>
</LinearLayout>
