<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="18dp"
    android:paddingEnd="28dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/download_version_subtitle"
        android:textColor="#C7D4DF"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/fabric_installer_only_stable_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:buttonTint="#8FD4B3"
        android:checked="true"
        android:text="@string/fabric_dl_only_stable"
        android:textColor="#FFFFFFFF" />

    <ProgressBar
        android:id="@+id/fabric_installer_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:indeterminateTint="#8FD4B3" />

    <LinearLayout
        android:id="@+id/fabric_installer_retry_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_battly_form_section"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/modloader_dl_failed_to_load_list"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/fabric_installer_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:minWidth="0dp"
            android:text="@string/global_retry"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/fabric_installer_stage_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:contentDescription="@string/launcher_nav_back"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back_white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fabric_installer_stage_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/noto_sans_bold"
            android:text="@string/modloader_select_minecraft_version"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fabric_installer_version_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="14dp"
        android:scrollbars="none" />
</LinearLayout>
