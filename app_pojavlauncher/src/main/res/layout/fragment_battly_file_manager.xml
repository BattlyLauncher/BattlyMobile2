<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_battly_launcher_play"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_battly_launcher_chip"
            android:padding="9dp"
            android:src="@drawable/ic_folder"
            app:tint="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:text="@string/battly_files_title"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/battly_files_subtitle"
                android:textColor="#D4E1E8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/battly_files_up"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:contentDescription="@string/battly_files_up"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_compact" />

        <ImageButton
            android:id="@+id/battly_files_home"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:contentDescription="@string/battly_files_home"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home_compact"
            android:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/battly_files_path"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_form_field"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#DCE8EE"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/battly_files_view_mode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:contentDescription="@string/battly_files_grid_view"
            android:padding="10dp"
            android:src="@drawable/ic_view_grid"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/battly_files_open_system"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:contentDescription="@string/battly_files_open_system"
            android:padding="10dp"
            android:src="@drawable/ic_open_in_new"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/battly_files_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_battly_button_primary"
            android:contentDescription="@string/battly_files_refresh"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            android:tint="#FF10212B" />
    </LinearLayout>

    <TextView
        android:id="@+id/battly_files_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/battly_files_empty"
        android:textColor="#C7D4DF"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/battly_files_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none" />
</LinearLayout>
