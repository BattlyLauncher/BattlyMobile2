<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_battly_popup"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/instance_selector_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/content_install_select_profile_title"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/instance_selector_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/content_install_select_profile_subtitle"
        android:textColor="#C7D4DF"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/instance_selector_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/instance_selector_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_battly_button_secondary"
        android:text="@string/global_cancel"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold" />
</LinearLayout>
