<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_battly_bottom_sheet"
    android:orientation="vertical">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="3dp"
        android:background="#33FFFFFF" />

    <!-- Fixed Header: Icon + Title + Meta + Stats + Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/dialog_mod_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_battly_profile_icon"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dialog_mod_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Feed the Beast Omnia" />

                <ImageView
                    android:id="@+id/dialog_mod_source"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:alpha="0.80" />
            </LinearLayout>

            <TextView
                android:id="@+id/dialog_mod_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#99C7D4DF"
                android:textSize="13sp"
                tools:text="Modrinth · Fabric" />

            <!-- Stats row: downloads, follows, loader badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dialog_mod_downloads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAC7D4DF"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="&#8595; 167,917,547"
                    tools:visibility="visible" />

                <View
                    android:id="@+id/dialog_mod_stats_divider"
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="#33FFFFFF"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/dialog_mod_follows"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAC7D4DF"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="&#9829; 30,466"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/dialog_mod_loader_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_battly_form_field"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Fabric"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/dialog_mod_close_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_battly_form_field"
            android:contentDescription="@string/mod_detail_close"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close_white"
            app:tint="#CCFFFFFF" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Scrollable body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadeScrollbars="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/dialog_mod_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="#CCE6EFF5"
                android:textSize="12sp"
                tools:text="Machine and magic focused modpack with a large progression tree and a lot of content." />

            <LinearLayout
                android:id="@+id/dialog_mod_detail_columns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dialog_mod_loader_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:letterSpacing="0.08"
                        android:text="@string/mod_detail_step_loader"
                        android:textAllCaps="true"
                        android:textColor="#66C7D4DF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dialog_mod_loader_selector"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_battly_form_field"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_battly_chevron"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#DCEAF1"
                        android:textSize="13sp"
                        tools:text="Fabric" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:layout_marginBottom="3dp"
                        android:letterSpacing="0.08"
                        android:text="@string/mod_detail_step_minecraft"
                        android:textAllCaps="true"
                        android:textColor="#66C7D4DF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dialog_mod_minecraft_selector"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_battly_form_field"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_battly_chevron"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#DCEAF1"
                        android:textSize="12sp"
                        tools:text="Minecraft 1.21.4" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:layout_marginBottom="3dp"
                        android:letterSpacing="0.08"
                        android:text="@string/mod_detail_step_content_version"
                        android:textAllCaps="true"
                        android:textColor="#66C7D4DF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dialog_mod_version_selector"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_battly_form_field"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_battly_chevron"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#DCEAF1"
                        android:textSize="13sp"
                        tools:text="2.4.0 · Recommended" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dialog_mod_preview_container"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="0.8"
                    android:background="@drawable/bg_battly_form_field"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/dialog_mod_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_battly_profile_icon"
                            android:clipToOutline="true"
                            android:contentDescription="@string/mod_detail_preview"
                            android:scaleType="centerCrop" />

                        <ProgressBar
                            android:id="@+id/dialog_mod_preview_loading"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="#82D9C7" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/mod_detail_preview"
                        android:textColor="#AAC7D4DF"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="3dp"
                android:text="@string/mod_detail_label_deps"
                android:textAllCaps="true"
                android:textColor="#66C7D4DF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_mod_dependency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_battly_form_field"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="#C7D4DF"
                android:textSize="13sp"
                android:visibility="visible"
                tools:text="No hay dependencias requeridas." />

            <TextView
                android:id="@+id/dialog_mod_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_battly_form_field"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/search_modpack_download_error"
                android:textColor="#FF7070"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Divider above actions -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Fixed action row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/dialog_mod_deps_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_button_secondary"
            android:text="@string/mod_dependency_install_button"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/dialog_mod_install_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battly_button_primary"
            android:enabled="false"
            android:text="@string/generic_install"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
