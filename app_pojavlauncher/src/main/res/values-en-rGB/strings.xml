    <string name="battly_whats_new_action_start">Explore 2.1.1</string>
    <string name="battly_whats_new_compatibility_desc">HTTP/2, connection reuse, resumable downloads and automatic retries. Battly uses 64 simultaneous downloads by default and lets you choose up to 100.</string>
    <string name="battly_whats_new_compatibility_title">Downloads built for speed</string>
    <string name="battly_whats_new_controllers_desc">Set up PlayStation, Xbox and Nintendo Switch controllers with a guided assistant, animated 3D previews, stick calibration and per-instance mappings.</string>
    <string name="battly_whats_new_controllers_title">Controllers, your way</string>
    <string name="battly_whats_new_desc">A major update for controllers, downloads, instances, performance and stability.</string>
    <string name="battly_whats_new_instances_desc">Manage worlds, mods and installed content, create local backups, safely update modpacks and open them as soon as installation finishes.</string>
    <string name="battly_whats_new_instances_title">Your instances, protected</string>
    <string name="battly_whats_new_recovery_desc">The maintenance center detects damaged files and incompatible mods. FPS, real server ping, touch controls, ESC, crash recovery and translations have also improved.</string>
    <string name="battly_whats_new_recovery_title">More stable, easier to fix</string>
    <string name="battly_whats_new_title">Battly Mobile 2.1.1</string>
    <string name="battly_whats_new_transition_desc">Your profiles are intact and ready to play.</string>
    <string name="battly_whats_new_transition_title">Battly 2.1.1 is ready</string>
    <string name="battly_whats_new_worlds_desc">Battly selects Java, LWJGL and the renderer for each version. MobileGlues 2.0.0 adds new graphics options and broader compatibility.</string>
    <string name="battly_whats_new_worlds_title">Smarter graphics and compatibility</string>
