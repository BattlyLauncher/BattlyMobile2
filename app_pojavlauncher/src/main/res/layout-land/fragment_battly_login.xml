<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_battly_form_panel"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/login_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="28dp"
        android:paddingEnd="32dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_battly_profile_icon"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_sans_bold"
            android:text="@string/auth_method_battly"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/battly_login_subtitle"
            android:textColor="#C7D4DF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:includeFontPadding="false"
                    android:text="@string/battly_login_username_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/battly_edit_username"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_battly_form_field"
                    android:fontFamily="@font/noto_sans_bold"
                    android:hint="@string/battly_login_username_hint"
                    android:imeOptions="flagNoExtractUi|actionNext"
                    android:inputType="text"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#93B1C0"
                    android:textSize="15sp" />
            </LinearLayout>

            <Space
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:includeFontPadding="false"
                    android:text="@string/battly_login_password_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/battly_edit_password"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_battly_form_field"
                    android:fontFamily="@font/noto_sans_bold"
                    android:hint="@string/battly_login_password_hint"
                    android:imeOptions="flagNoExtractUi|actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#93B1C0"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/battly_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="#FF5555"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/battly_login_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_battly_button_primary"
            android:fontFamily="@font/noto_sans_bold"
            android:text="@string/battly_login_button"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/battly_register_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_battly_button_secondary"
            android:fontFamily="@font/noto_sans_bold"
            android:text="@string/battly_register_button"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
